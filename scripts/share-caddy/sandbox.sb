; sandbox-exec profile for the share server's caddy. Caddy follows symlinks, so a link in the share folder could
; serve any file the user can read; under this profile caddy reads nothing in home or temp folders except the
; share folder (ROOT, real path), this config directory (CONF) and its own state (STATE), and nothing hidden
; inside ROOT, whatever path the request took to get there. Blocked reads come back as 403.
(version 1)
(allow default)
(deny file-read* file-write*
  (subpath "/Users") (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/Volumes"))
(allow file-read* (subpath (param "ROOT")) (subpath (param "CONF")))
(allow file-read* file-write* (subpath (param "STATE")))
(deny file-read* (regex (string-append "^" (param "ROOT") "/(.*/)?\\.")))
